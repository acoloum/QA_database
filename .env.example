# ============================================
# QA Database - 開發環境設定範例
# 複製為 .env 後再依實際環境修改
# ============================================

# PostgreSQL 連線
DB_HOST=localhost
DB_PORT=5432
DB_NAME=qa_database
DB_USER=postgres
DB_PASSWORD=change-me

# Flask 安全金鑰 (請改為亂數值)
# 產生方法: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=please-change-to-a-random-secret

# JWT Token 有效時數
TOKEN_EXPIRATION_HOURS=24

# CORS 白名單 (以逗號分隔)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
