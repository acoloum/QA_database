{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Frontend (Vite)",
      "runtimeExecutable": "node",
      "runtimeArgs": ["node_modules/vite/bin/vite.js"],
      "port": 80,
      "cwd": "src_frontend"
    },
    {
      "name": "Backend (Flask)",
      "runtimeExecutable": "venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "flask", "--app", "backend.app:app", "run", "--port", "5001"],
      "port": 5001
    }
  ]
}
